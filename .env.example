# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Postgres, e.g. Neon: Dashboard → Connect) ---
# Direct connection: used for migrations (drizzle-kit) and scripts.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional pooled connection (Neon "-pooler" host): used by the app at runtime if set.
DATABASE_URL_POOLED=

# --- Auth (Better Auth) ---
# Random secret, e.g. `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public base URL of the site (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys for test mode ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Optional: only needed for /api/payments/webhook (Dashboard → Webhooks → the secret you choose)
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (Settings → API → Configure → create an API user; NOT your main login) ---
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# Nickname of the pickup address in Shiprocket → Settings → Pickup Addresses (default "Primary")
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: only needed for /api/shipping/webhook (the token you enter in Shiprocket → Settings → API → Webhooks)
SHIPROCKET_WEBHOOK_TOKEN=
